APP_NAME="Retail SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_PORT=8088
VITE_PORT=5174
PORT=8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

COMPOSE_PROJECT_NAME=retail_saas
POSTGRES_VOLUME=retail_saas_postgres_data

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_FORWARD_PORT=5434
DB_DATABASE=retail_saas_db
DB_USERNAME=retail_saas_user
DB_PASSWORD=change_me
DB_SSLMODE=prefer

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_SMTP_PORT=1027
MAILPIT_UI_PORT=8027

RAILWAY_DEPLOY=false
VITE_APP_NAME="${APP_NAME}"

PLATFORM_CONTACT_PHONE=

# Cloudflare R2 (fotos de comprobantes de pago). Ver comentario detallado
# en el .env real de cada dispositivo.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto
